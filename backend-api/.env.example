# Copy this file to .env and fill in the real values before running the server.
# On Render: set each variable in Dashboard → Your Service → Environment.

PORT=10000

# MongoDB Atlas connection string
# Get it from: https://cloud.mongodb.com → Clusters → Connect → Drivers
# Format: mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/helphive?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://<db_user>:<db_password>@cluster0.lnzjege.mongodb.net/helphive?retryWrites=true&w=majority

# JWT secret – use a long random string (generate with: openssl rand -hex 32)
JWT_SECRET=replace-with-strong-secret

# Comma-separated list of allowed frontend origins
CLIENT_URLS=http://localhost:5173,http://localhost:5174,http://localhost:5175

# Groq AI API key (optional – from https://console.groq.com)
GROQ_API_KEY=replace-with-groq-key

OPENAI_API_KEY=replace-with-openai-key
OPENAI_MODEL=gpt-4o-mini
PYTHON_EXECUTABLE=python
